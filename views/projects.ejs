<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>
  <body>
    
       

<%- include('partials/header') %>

<!-- Projects page introduction -->
<section class="p-4 mb-4">
    <h1>My Projects</h1>
    <p>
        Here are some academic projects I have completed
        throughout my studies at Ontario Tech University.
    </p>
</section>

<!-- Bootstrap project cards -->
<section class="p-4 mb-4">
    <h2>Academic Projects</h2>

    <div class="row g-4 mt-2">

        <!-- Networking project -->
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="card-title">
                        Networking Case Study
                    </h3>
                    <p class="card-text">
                        Analyzed networking issues and
                        proposed solutions to improve
                        network performance and reliability.
                    </p>
                </div>
            </div>
        </div>

        <!-- Python banking application -->
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="card-title">
                        Python Banking Application
                    </h3>
                    <p class="card-text">
                        Developed a Python application
                        that supports account management,
                        deposits, withdrawals, and
                        balance checking.
                    </p>
                </div>
            </div>
        </div>

        <!-- Inventory management system -->
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="card-title">
                        Inventory Management System
                    </h3>
                    <p class="card-text">
                        Created a Python inventory system
                        that allows users to add, update,
                        and remove inventory items.
                    </p>
                </div>
            </div>
        </div>

        <!-- Business management project -->
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="card-title">
                        Business Development Project
                    </h3>
                    <p class="card-text">
                        Developed a hypothetical business
                        plan involving market research,
                        marketing strategies, and
                        financial projections.
                    </p>
                </div>
            </div>
        </div>

        <!-- Leadership case study -->
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="card-title">
                        Leadership Case Study
                    </h3>
                    <p class="card-text">
                        Evaluated leadership approaches
                        and examined how leadership
                        decisions influence teamwork
                        and organizational outcomes.
                    </p>
                </div>
            </div>
        </div>

    </div>
</section>

<%- include('partials/footer') %>



  </body>
</html>